{% if meta == "uv" %}
[project]
name = "{{ project_name }}"
version = "{{ package_version | in_double_quote_literal }}"
description = "{{ package_description | in_double_quote_literal }}"
license = "MIT"
authors = [
    { name = "Jiyang Ye", email = "jiyang.ye@ngi.no" },
]
maintainers = [
    { name = "Jiyang Ye", email = "jiyang.ye@ngi.no" },
    { name = "Jostein Leira", email = "jostein.leira@ngi.no" },
]
readme = "README.md"
requires-python = ">=3.13,<4.0"
dependencies = [
    "httpx>=0.20.0,<0.29.0",
    "attrs>=22.2.0",
    "python-dateutil>=2.8.0,<3",
]

[tool.uv.build-backend]
module-name = "{{ package_name }}"
module-root = ""

[build-system]
requires = ["uv_build>=0.12.0,<0.13.0"]
build-backend = "uv_build"
{% endif %}

{% include "pyproject_ruff.toml.jinja" %}
